# Copy to /etc/rift-hub/hub-secrets.env and replace values securely. Never commit this file.
RIFT_ENV=production
RIFT_SERVER_PORT=8765
RIFT_AWS_REGION=ap-southeast-2
# EC2 uses its instance role; do not set RIFT_AWS_PROFILE here.
RIFT_S3_BUCKET=rift-storage-903859732456-ap-southeast-2
RIFT_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/903859732456/rift-chunks-queue
RIFT_IOT_ENDPOINT=a30f3sdnp94spe-ats.iot.ap-southeast-2.amazonaws.com
RIFT_DEVICE_ID=rift-hub-sydney
RIFT_HUB_IOT_CLIENT_ID=rift-hub-sydney-listener
RIFT_HUB_IOT_CERT=/etc/rift-hub/secrets/hub.pem.crt
RIFT_HUB_IOT_PRIVATE_KEY=/etc/rift-hub/secrets/hub.private.key
RIFT_HUB_IOT_ROOT_CA=/etc/ssl/certs/AmazonRootCA1.pem
RIFT_REGISTRY_DB=/var/lib/rift/hub-devices.sqlite3
RIFT_LLM_MODEL=qwen2.5:3b
# Generate the shared command-signing secret with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
RIFT_HMAC_SECRET=REPLACE_WITH_RANDOM_48_BYTE_SHARED_AGENT_SECRET
# Optional extra browser origins; leave blank to allow only the same CloudFront host.
RIFT_ALLOWED_ORIGINS=
